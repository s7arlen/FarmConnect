# Port for REST API Service
PORT=5000

# PostgreSQL Connection String (Local / Supabase / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/farmconnect"

# JWT Secret for Mobile Client Token Signing
JWT_SECRET="farmconnect-secret-key-change-in-production-2026"

# Cloudinary CDN (Optional for production image storage)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
